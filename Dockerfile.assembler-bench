# Dedicated MiCall fork image: one assembler only.
ARG FORK_BASE_IMAGE
FROM ${FORK_BASE_IMAGE}
ARG FORK_BASE_IMAGE
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_FORK_BASE_COMMIT
RUN command -v iva && command -v samtools
RUN test "$(samtools --version | head -1)" = "samtools 1.3.1"
ENV MICALL_DENOVO_ASSEMBLER=iva
LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.common-baseline-commit="${MICALL_FORK_BASE_COMMIT}"
LABEL org.ottojung.micall.source-branch="bench/assembler-iva-v2"
LABEL org.ottojung.micall.assembler="iva"
