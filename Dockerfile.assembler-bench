# Dedicated MiCall fork image for exactly one NONQUALIFYING exploratory assembler.
# Nothing from the frozen seven-tool clinical image is copied or rebuilt here.
ARG FORK_BASE_IMAGE
FROM ${FORK_BASE_IMAGE}
ARG FORK_BASE_IMAGE
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_FORK_BASE_COMMIT
ARG TOOL_SOURCE_REPO
ARG TOOL_SOURCE_COMMIT
ARG TOOL_BINARY_SHA256
ARG MICALL_ADAPTER_COMMANDS_SHA256
ARG MICALL_ADAPTER_DISPATCH_SHA256
ARG SPADES_SOURCE_REPO
ARG SPADES_SOURCE_COMMIT
ARG SPADES_BINARY_SHA256
RUN test "${#MICALL_FORK_SOURCE_COMMIT}" -eq 40 \
    && test "${#MICALL_FORK_BASE_COMMIT}" -eq 40 \
    && test "${#TOOL_SOURCE_COMMIT}" -eq 40 \
    && test "${#TOOL_BINARY_SHA256}" -eq 64 \
    && test "${#SPADES_SOURCE_COMMIT}" -eq 40
ENV MICALL_DENOVO_ASSEMBLER="unicycler"
# Install exact MiCall fork adapter source into its dedicated image.
# The original common clinical image remains an immutable parent.
RUN test -d /opt/venv/lib/python3.12/site-packages/micall/core
COPY micall/core/assembler_commands.py /opt/venv/lib/python3.12/site-packages/micall/core/assembler_commands.py
COPY micall/core/assembler_dispatch.py /opt/venv/lib/python3.12/site-packages/micall/core/assembler_dispatch.py
RUN test "$(sha256sum /opt/venv/lib/python3.12/site-packages/micall/core/assembler_commands.py | cut -d' ' -f1)" = "${MICALL_ADAPTER_COMMANDS_SHA256}"     && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/micall/core/assembler_dispatch.py | cut -d' ' -f1)" = "${MICALL_ADAPTER_DISPATCH_SHA256}"     && /opt/venv/bin/python -c "from micall.core.assembler_commands import ASSEMBLERS; assert 'unicycler' in ASSEMBLERS"
RUN test "${MICALL_DENOVO_ASSEMBLER}" = "unicycler"

# Build toolchain: SPAdes 3.15.5 needs g++ >= 5.3.1, cmake >= 3.5, zlib and
# libbz2; Unicycler needs python3 + setuptools and builds a C++ shared object.
# ncbi-blast+ supplies makeblastdb/tblastn for Unicycler's optional start-gene
# checks; the invoked short-read path passes no reference or truth of any kind.
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ cmake make zlib1g-dev libbz2-dev \
      python3 python3-setuptools ncbi-blast+ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Reproducible SPAdes dependency: build the exact pinned upstream commit.
RUN git clone --quiet ${SPADES_SOURCE_REPO} /opt/spades-src \
    && cd /opt/spades-src \
    && git checkout --quiet ${SPADES_SOURCE_COMMIT} \
    && test "$(git rev-parse HEAD)" = "${SPADES_SOURCE_COMMIT}" \
    && cd assembler \
    && PREFIX=/opt/spades ./spades_compile.sh -j 2 \
    && test -x /opt/spades/bin/spades.py \
    && test -x /opt/spades/bin/spades-core \
    && echo "${SPADES_BINARY_SHA256}  /opt/spades/bin/spades-core" | sha256sum -c -
ENV PATH=/opt/spades/bin:${PATH}

# Unicycler itself, from the exact pinned upstream commit.
RUN git clone --quiet ${TOOL_SOURCE_REPO} /opt/Unicycler \
    && cd /opt/Unicycler \
    && git checkout --quiet ${TOOL_SOURCE_COMMIT} \
    && test "$(git rev-parse HEAD)" = "${TOOL_SOURCE_COMMIT}" \
    && python3 setup.py install \
    && test -f /opt/Unicycler/unicycler/cpp_functions.so \
    && unicycler --help >/dev/null \
    && echo "${TOOL_BINARY_SHA256}  /opt/Unicycler/unicycler/cpp_functions.so" | sha256sum -c -

LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.common-baseline-commit="${MICALL_FORK_BASE_COMMIT}"
LABEL org.ottojung.micall.source-branch="bench/assembler-unicycler"
LABEL org.ottojung.micall.assembler="unicycler"
LABEL org.ottojung.exploratory.tool-source-repo="${TOOL_SOURCE_REPO}"
LABEL org.ottojung.exploratory.tool-source-commit="${TOOL_SOURCE_COMMIT}"
LABEL org.ottojung.exploratory.tool-binary-sha256="${TOOL_BINARY_SHA256}"
LABEL org.ottojung.exploratory.spades-source-repo="${SPADES_SOURCE_REPO}"
LABEL org.ottojung.exploratory.spades-binary-sha256="${SPADES_BINARY_SHA256}"
LABEL org.ottojung.exploratory.spades-source-commit="${SPADES_SOURCE_COMMIT}"
LABEL org.ottojung.exploratory.tool-license="GPL-3.0"
LABEL org.ottojung.exploratory.nonqualifying="true"
LABEL org.ottojung.micall.adapter-commands-sha256="${MICALL_ADAPTER_COMMANDS_SHA256}"
LABEL org.ottojung.micall.adapter-dispatch-sha256="${MICALL_ADAPTER_DISPATCH_SHA256}"
