# Dedicated MiCall fork image: one assembler only.
ARG FORK_BASE_IMAGE
FROM quay.io/biocontainers/haploflow@sha256:eaf03733093a99a290d6b30af3a4b95543d9accfe63ff37851a0e5de6c02396d AS tool_donor
FROM ${FORK_BASE_IMAGE}
ARG FORK_BASE_IMAGE
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_FORK_BASE_COMMIT
COPY --from=tool_donor /usr/local/bin/haploflow /usr/local/bin/haploflow
COPY --from=tool_donor /usr/local/lib/libboost_filesystem.so.1.85.0 /usr/local/lib/
COPY --from=tool_donor /usr/local/lib/libboost_program_options.so.1.85.0 /usr/local/lib/
COPY --from=tool_donor /usr/local/lib/libstdc++.so.6.0.33 /usr/local/lib/
COPY --from=tool_donor /usr/local/lib/libgcc_s.so.1 /usr/local/lib/
RUN ln -sf libstdc++.so.6.0.33 /usr/local/lib/libstdc++.so.6 && ldconfig
RUN command -v haploflow
ENV MICALL_DENOVO_ASSEMBLER=haploflow
LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.common-baseline-commit="${MICALL_FORK_BASE_COMMIT}"
LABEL org.ottojung.micall.source-branch="bench/assembler-haploflow-v2"
LABEL org.ottojung.micall.assembler="haploflow"
