# Dedicated MiCall fork image: one assembler only.
ARG FORK_BASE_IMAGE
ARG IVANKA_IMAGE
FROM ${IVANKA_IMAGE} AS tool_donor
FROM ${FORK_BASE_IMAGE}
ARG FORK_BASE_IMAGE
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_FORK_BASE_COMMIT
ARG IVANKA_SOURCE_COMMIT
COPY --from=tool_donor /usr/local/bin/ivanka /usr/local/bin/ivanka
RUN command -v ivanka
ENV MICALL_DENOVO_ASSEMBLER=ivanka
LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.common-baseline-commit="${MICALL_FORK_BASE_COMMIT}"
LABEL org.ottojung.micall.source-branch="experiment/ivanka-readspan-cycle-20261113"
LABEL org.ottojung.micall.assembler="ivanka"
LABEL org.ottojung.ivanka.source-commit="${IVANKA_SOURCE_COMMIT}"

LABEL org.ottojung.ivanka.experiment="unqualified-readspan-cycle-openings"
