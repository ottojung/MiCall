# Dedicated MiCall fork image for exactly one NONQUALIFYING exploratory assembler.
# Nothing from the frozen seven-tool clinical image is copied or rebuilt here.
ARG FORK_BASE_IMAGE
FROM ${FORK_BASE_IMAGE}
ARG FORK_BASE_IMAGE
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_FORK_BASE_COMMIT
ARG TOOL_SOURCE_REPO
ARG TOOL_SOURCE_COMMIT
ARG TOOL_BINARY_SHA256
ARG MICALL_ADAPTER_COMMANDS_SHA256
ARG MICALL_ADAPTER_DISPATCH_SHA256
RUN test "${#MICALL_FORK_SOURCE_COMMIT}" -eq 40 \
    && test "${#MICALL_FORK_BASE_COMMIT}" -eq 40 \
    && test "${#TOOL_SOURCE_COMMIT}" -eq 40 \
    && test "${#TOOL_BINARY_SHA256}" -eq 64
ENV MICALL_DENOVO_ASSEMBLER="savage"
# Install exact MiCall fork adapter source into its dedicated image.
# The original common clinical image remains an immutable parent.
RUN test -d /opt/venv/lib/python3.12/site-packages/micall/core
COPY micall/core/assembler_commands.py /opt/venv/lib/python3.12/site-packages/micall/core/assembler_commands.py
COPY micall/core/assembler_dispatch.py /opt/venv/lib/python3.12/site-packages/micall/core/assembler_dispatch.py
RUN test "$(sha256sum /opt/venv/lib/python3.12/site-packages/micall/core/assembler_commands.py | cut -d' ' -f1)" = "${MICALL_ADAPTER_COMMANDS_SHA256}"     && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/micall/core/assembler_dispatch.py | cut -d' ' -f1)" = "${MICALL_ADAPTER_DISPATCH_SHA256}"     && /opt/venv/bin/python -c "from micall.core.assembler_commands import ASSEMBLERS; assert 'savage' in ASSEMBLERS"
RUN test "${MICALL_DENOVO_ASSEMBLER}" = "savage"
# python2.7 is required by HaploConduct/SAVAGE (Python 2) but is not in Debian
# bookworm; install it from the bullseye archive. python-scipy is not needed for
# the reference-free de-novo paired-FASTQ flow (only scripts/min_ev_table.py).
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ make libboost-all-dev ncbi-blast+ git ca-certificates \
    && echo "deb http://archive.debian.org/debian bullseye main" > /etc/apt/sources.list.d/bullseye.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid \
    && apt-get update && apt-get install -y --no-install-recommends python2.7 \
    && ln -sf /usr/bin/python2.7 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/bullseye.list /etc/apt/apt.conf.d/99no-check-valid
# Pinned SAVAGE in de-novo-only mode: paired FASTQs via -p1/-p2, never --ref
# and never --count_strains (both require a reference genome).
RUN git clone --quiet ${TOOL_SOURCE_REPO} /src/haploconduct \
    && cd /src/haploconduct && git checkout --quiet ${TOOL_SOURCE_COMMIT} \
    && test "$(git rev-parse HEAD)" = "${TOOL_SOURCE_COMMIT}" \
    && make -j4 \
    && mkdir -p /opt/savage \
    && cp -a . /opt/savage \
    && printf '#!/bin/sh\nexec /opt/savage/haploconduct savage "$@"\n' > /usr/local/bin/savage \
    && chmod 0755 /usr/local/bin/savage \
    && rm -rf /src/haploconduct
# A provenance label alone is not proof; fail the image build on a binary hash mismatch.
RUN test -x /opt/savage/haploconduct && test "$(sha256sum /opt/savage/haploconduct | cut -d' ' -f1)" = "${TOOL_BINARY_SHA256}"
LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.common-baseline-commit="${MICALL_FORK_BASE_COMMIT}"
LABEL org.ottojung.micall.source-branch="bench/assembler-savage"
LABEL org.ottojung.micall.assembler="savage"
LABEL org.ottojung.exploratory.tool-source-repo="${TOOL_SOURCE_REPO}"
LABEL org.ottojung.exploratory.tool-source-commit="${TOOL_SOURCE_COMMIT}"
LABEL org.ottojung.exploratory.tool-binary-sha256="${TOOL_BINARY_SHA256}"
LABEL org.ottojung.micall.adapter-commands-sha256="${MICALL_ADAPTER_COMMANDS_SHA256}"
LABEL org.ottojung.micall.adapter-dispatch-sha256="${MICALL_ADAPTER_DISPATCH_SHA256}"
