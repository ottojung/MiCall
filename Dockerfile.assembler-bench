# Build only atop the exact fork-built MiCall source revision.
ARG FORK_BASE_IMAGE
ARG IVANKA_IMAGE
FROM ${IVANKA_IMAGE} AS ivanka_tool

FROM quay.io/biocontainers/haploflow@sha256:eaf03733093a99a290d6b30af3a4b95543d9accfe63ff37851a0e5de6c02396d AS haploflow_tool

FROM ${FORK_BASE_IMAGE}
ARG MICALL_FORK_SOURCE_COMMIT
ARG MICALL_DENOVO_ASSEMBLER
ARG IVANKA_SOURCE_COMMIT
ARG FORK_BASE_IMAGE
RUN apt-get update && apt-get install -y --no-install-recommends \
      megahit=1.2.9-4 abyss=2.3.5+dfsg-2 \
      spades=3.15.5+dfsg-2 velvet=1.2.10+dfsg1-8 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=haploflow_tool /usr/local/bin/haploflow /usr/local/bin/haploflow
COPY --from=haploflow_tool /usr/local/lib/libboost_filesystem.so.1.85.0 /usr/local/lib/
COPY --from=haploflow_tool /usr/local/lib/libboost_program_options.so.1.85.0 /usr/local/lib/
COPY --from=haploflow_tool /usr/local/lib/libstdc++.so.6.0.33 /usr/local/lib/
COPY --from=haploflow_tool /usr/local/lib/libgcc_s.so.1 /usr/local/lib/
COPY --from=ivanka_tool /usr/local/bin/ivanka /usr/local/bin/ivanka
RUN ln -sf libstdc++.so.6.0.33 /usr/local/lib/libstdc++.so.6 && \
    ldconfig
RUN case "${MICALL_DENOVO_ASSEMBLER}" in \
      iva|ivanka|haploflow|megahit|abyss|spades|velvet) ;; \
      *) echo "unknown MiCall assembler" >&2; exit 1;; esac
ENV MICALL_DENOVO_ASSEMBLER="${MICALL_DENOVO_ASSEMBLER}"
LABEL org.opencontainers.image.source="https://github.com/ottojung/MiCall"
LABEL org.opencontainers.image.revision="${MICALL_FORK_SOURCE_COMMIT}"
LABEL org.ottojung.micall.common-base="${FORK_BASE_IMAGE}"
LABEL org.ottojung.micall.assembler="${MICALL_DENOVO_ASSEMBLER}"
LABEL org.ottojung.ivanka.source-commit="${IVANKA_SOURCE_COMMIT}"
